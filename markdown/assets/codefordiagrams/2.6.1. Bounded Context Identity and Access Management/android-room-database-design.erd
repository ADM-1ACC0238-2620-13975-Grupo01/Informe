%% Android Room local persistence for Identity and Access Management
erDiagram
    CACHED_IDENTITY {
        int user_id PK
        text username
        text full_name
        text role
        datetime expires_at
        text sync_state
    }
    PENDING_OPERATIONS {
        text operation_id PK
        text aggregate_type
        text aggregate_id
        text operation_type
        text payload_json
        datetime created_at
        int retry_count
        text status
    }
