erDiagram
    USERS ||--o{ FINANCIAL_RECORDS : owns
    USERS {
        int id PK
    }
    FINANCIAL_RECORDS {
        int id PK
        int owner_id FK
        varchar type "required, max 20"
        varchar category "required, max 80"
        decimal amount "precision 10,2"
        varchar currency "target addition, default PEN"
        date record_date "required"
        varchar description
    }
